# ===== 오네시스(Onesis) 환경변수 예시 =====
# 이 파일을 복사해서 .env 로 만들고 값을 채워 넣으세요.
#   cp .env.example .env
# (.env 파일은 절대 깃에 올라가지 않습니다 — .gitignore 에 등록됨)

# --- 로그인 비밀번호 (반드시 바꾸세요!) ---
# 이 비밀번호를 알아야만 접속할 수 있습니다. 나만 아는 값으로 바꾸세요.
LOGIN_PASSWORD=바꿔주세요

# --- 로그인 토큰 서명용 비밀키 (아무 긴 임의 문자열) ---
SESSION_SECRET=길고-아무도-모르는-임의의-문자열로-바꾸세요

# --- 3개 AI API 키 (없는 키는 비워두면 해당 AI만 자동 제외됩니다) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- (선택) 사용할 모델 이름. 비워두면 아래 기본값이 쓰입니다. ---
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-2.0-flash

# --- (선택) 데이터 저장 폴더. 클라우드에서는 영구 볼륨 경로로 지정하세요. ---
# DATA_DIR=/data
